# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Postgres connection string (Neon). On Vercel this is set automatically when
# you connect a Neon database under the project's Storage tab. For local dev,
# copy it from Vercel (Settings -> Environment Variables) or run `vercel env pull`.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Password for the built-in Dev1 / Dev2 admin accounts (defaults to 1234).
DEV_PASSWORD=1234
